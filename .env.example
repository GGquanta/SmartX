# SmartX Environment Variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# Development Configuration
VITE_DEV_SERVER_PORT=5173

# First launch: auto-create default AI provider when none is configured yet
# (read by Electron main process from .env / .env.local in dev, or from
# resources/provider-defaults.env in packaged builds — written at CI/package time)
# PROVIDER_DEFAULT_NAME=bailian
# PROVIDER_DEFAULT_APIKEY=
# PROVIDER_DEFAULT_MODEL=qwen3.7-max
# PROVIDER_DEFAULT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Company Knowledge page: embedded web app URL (Vite; defaults to http://localhost:5001/ if unset)
VITE_COMPANY_KNOWLEDGE_URL=http://localhost:5001/

# Release Configuration (CI/CD)
# macOS code signing + notarization (same method as quantamate-demo)
# Preferred: App Store Connect API Key + Developer ID Application
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_API_KEY_P8_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
#
# Optional .p12 when the identity is not already in Keychain (CI):
# CSC_LINK=/path/to/DeveloperID.p12
# CSC_LINK_PATH=/path/to/DeveloperID.p12
# CSC_KEY_PASSWORD=p12_password
#
# Legacy Apple ID notarization (not recommended):
# APPLE_ID=your@email.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# GitHub Token for releases
GH_TOKEN=github_personal_access_token
